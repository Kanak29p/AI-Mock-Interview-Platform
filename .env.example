# ========================================================
# AI Mock Interview Platform - Master Environment Variables
# ========================================================

# Application Port
PORT=5000
NODE_ENV=development

# Frontend URL for CORS
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000

# PostgreSQL Configuration (Docker & Local)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=mock_interview_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mock_interview_db

# Redis Configuration (Docker & Local)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# JWT Authentication
# IMPORTANT: Generate secure random keys for production (e.g. openssl rand -base64 32)
JWT_SECRET=super_secret_jwt_key_mock_interview_change_in_production_min32chars
JWT_REFRESH_SECRET=super_secret_refresh_key_mock_interview_change_in_production_min32chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# --------------------------------------------------------
# External AI & Code Execution Services (Required in Phase 2 & beyond)
# --------------------------------------------------------
# Google Gemini API Key: Get from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Judge0 API Key: RapidAPI or self-hosted Judge0 instance
JUDGE0_API_KEY=your_judge0_api_key_here
